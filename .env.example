SOLANA_RPC_ENDPOINT=https://solana-mainnet.core.chainstack.com/...
ETHEREUM_RPC_ENDPOINT=https://eth-mainnet.g.alchemy.com/...
BNB_RPC_ENDPOINT=https://bnb-mainnet.g.alchemy.com/v2/...
ARB_RPC_ENDPOINT=https://arb-mainnet.g.alchemy.com/v2/...
BASE_RPC_ENDPOINT=https://base-mainnet.g.alchemy.com/v2/...

COINGECKO_API=CG...

REDIS__HOST=localhost
REDIS__PORT=6379

MIN_VOL24=10_000
MIN_TVL=7_000

# in seconds
METADATA_FETCH_INTERVAL=1800

METADATA_DECAY_PERIOD=300

EVM_TICKS_FETCH_RANGE=50

POOL_STATE_DECAY_TIME=5

MINIMAL_PROFIT=1
SWAPPER_FEE=0.005

# how many paths to pick from one itteration of probing
OSR_V1_LEVEL_DEPTH=3

# ---------------------------------------------------------------------------
# CEX credentials (contract-address checker). No hardcoded fallbacks remain in
# source — these MUST be set in the real .env or the contracts worker fails fast.
# ---------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
MEXC_API_KEY=
MEXC_SECRET_KEY=
BINGX_API_KEY=
BINGX_SECRET_KEY=
COINEX_API_KEY=
COINEX_SECRET_KEY=

# Optional Redis auth (consumers + producer read these)
REDIS_PASSWORD=
REDIS_DB=0

# CEX proxy-rotation Telegram alerts (optional; notifications skipped if unset)
CEX_TELEGRAM_BOT_TOKEN=
CEX_TELEGRAM_CHAT_ID=
