[Unit]
Description=SoulScan State Fetcher - Fetches live pool state via RPC
After=network.target redis.service soulscan-metadata-fetcher.service
Requires=redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/HorizonEvent/SoulScan
Environment="PYTHONPATH=/root/HorizonEvent/SoulScan"
ExecStart=/root/HorizonEvent/SoulScan/venv/bin/python -m scripts.run_supervisor state_fetcher
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
