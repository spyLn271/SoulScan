[Unit]
Description=SoulScan Smart Router - Computes optimal swap routes
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/HorizonEvent/SoulScan
Environment="PYTHONPATH=/root/HorizonEvent/SoulScan"
ExecStart=/root/HorizonEvent/SoulScan/venv/bin/python -m scripts.run_supervisor smart_router
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
