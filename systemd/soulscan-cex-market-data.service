[Unit]
Description=SoulScan CEX Market Data Handlers - Refreshes per-exchange ticker hashes in Redis
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/HorizonEvent/SoulScan
Environment="PYTHONPATH=/root/HorizonEvent/SoulScan"
EnvironmentFile=-/root/HorizonEvent/SoulScan/.env
ExecStart=/root/HorizonEvent/SoulScan/venv/bin/python -m scripts.run_supervisor cex_market_data
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
