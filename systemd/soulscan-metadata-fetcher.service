[Unit]
Description=SoulScan Metadata Fetcher - Fetches pool metadata from DEX APIs
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/HorizonEvent/SoulScan
Environment="PYTHONPATH=/root/HorizonEvent/SoulScan"
ExecStart=/root/HorizonEvent/SoulScan/venv/bin/python -m scripts.run_supervisor metadata_fetcher
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
