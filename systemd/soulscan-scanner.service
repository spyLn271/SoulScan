[Unit]
Description=SoulScan Scanner - Scans for CEX/DEX arbitrage opportunities
After=network.target redis.service soulscan-smart-router.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/HorizonEvent/SoulScan
Environment="PYTHONPATH=/root/HorizonEvent/SoulScan"
ExecStart=/root/HorizonEvent/SoulScan/venv/bin/python -m scripts.run_supervisor scanner
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
